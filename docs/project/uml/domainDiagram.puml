@startuml
title Domain Model (Conceptual Class Diagram)
hide methods
skinparam classAttributeIconSize 0
skinparam style strictuml

class User {
  studentId
  username
  fullName
  email
  faculty
  department
  role : STUDENT | STAFF
  authProvider : LOCAL | TU_API
}

class Item {
  id
  title
  category
  description
  imageUrl
  status : AVAILABLE | RESERVED | BORROWED | UNAVAILABLE
}

class BorrowRequest {
  id
  startDate
  endDate
  reason
  status : PENDING | ACCEPTED | REJECTED | CANCELLED
}

class Transaction {
  id
  status : ACTIVE | COMPLETED | DISPUTED
  borrowedAt
  returnedAt
}

class EvidenceProof {
  id
  proofType : HANDOVER | RETURN
  imageUrl
  note
  capturedAt
}

User "1" -- "0..*" Item : owns >
User "1" -- "0..*" BorrowRequest : submits >
Item "1" -- "0..*" BorrowRequest : requested in <
BorrowRequest "1" -- "0..1" Transaction : creates >
Transaction "1" *-- "0..*" EvidenceProof : records >
User "1" -- "0..*" EvidenceProof : uploads >
@enduml

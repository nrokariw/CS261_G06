@startuml
title Use Case Diagram (US-01 to US-09)
left to right direction
skinparam packageStyle rectangle

actor "TU User\n(Student / Staff)" as User
actor Borrower
actor Lender
actor "TU REST API" as TUAPI <<External System>>

User <|-- Borrower
User <|-- Lender

rectangle "CampusShare Lending System" {
  usecase "US-09: Login with TU Account" as UC_Login
  usecase "US-01: Create Item Listing" as UC_Create
  usecase "US-02: Browse Available Items" as UC_Browse
  usecase "US-04: Update / Delete Item" as UC_Manage
  usecase "US-03: Submit Borrow Request" as UC_Request
  usecase "US-05: Approve / Reject Request" as UC_Respond
  usecase "US-06: Record Handover Evidence" as UC_Handover
  usecase "US-07: Record Return Evidence" as UC_Return
  usecase "US-08: View History & Evidence" as UC_History
}

User --> UC_Login
UC_Login ..> TUAPI : <<include>>
User --> UC_Browse

Lender --> UC_Create
Lender --> UC_Manage
Lender --> UC_Respond
Lender --> UC_Handover
Lender --> UC_Return
Lender --> UC_History

Borrower --> UC_Request
Borrower --> UC_Handover
Borrower --> UC_Return
Borrower --> UC_History
@enduml

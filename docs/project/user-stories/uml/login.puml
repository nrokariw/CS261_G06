@startuml
title US-09: Login with TU Account
skinparam style strictuml
autonumber

actor User
participant Frontend
participant Backend
participant "Cache & RateLimit" as Guard
participant "TU REST API" as TU
database DB

User -> Frontend : Submit username & password
Frontend -> Backend : POST /api/auth/login

alt Invalid format
    Backend --> Frontend : 400 Bad Request
    Frontend --> User : Show format error
else Cache hit
    Guard --> Backend : Cached TuUserProfile
    Backend -> DB : Upsert user (no passwordHash)
    Backend --> Frontend : 200 OK {JWT, user}
    Frontend --> User : Redirect home
else Cache miss
    Backend -> Guard : Check IP limit (5 / 10m)
    alt Exceeded
        Guard --> Backend : 429 Too Many Requests
        Backend --> Frontend : 429 Rate Limit
        Frontend --> User : Show retry later
    else Allowed
        Backend -> TU : POST /auth/Ad/verify
        alt Invalid credentials
            TU --> Backend : 400 Invalid
            Backend --> Frontend : 401 Unauthorized
            Frontend --> User : Invalid credentials
        else Inactive account
            TU --> Backend : 200 (Inactive)
            Backend --> Frontend : 403 Forbidden
            Frontend --> User : Account inactive
        else Active account
            TU --> Backend : 200 {profile, role}
            Backend -> Guard : Cache profile (5m TTL)
            Backend -> DB : Upsert user (STUDENT / STAFF)
            Backend --> Frontend : 200 OK {JWT, user}
            Frontend --> User : Redirect home & show role
        end
    end
end
@enduml

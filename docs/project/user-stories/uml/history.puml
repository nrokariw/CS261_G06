@startuml
title US-06: Record Handover Evidence
skinparam style strictuml
autonumber

actor "Lender / Borrower" as User
participant Frontend
participant Backend
participant Storage
database DB

User -> Frontend : Attach photo & condition note
Frontend -> Backend : POST /api/transactions/start/{requestId} & /api/evidence/transaction/{id}
Backend -> DB : Verify participant & ACCEPTED status

alt Missing image or invalid input
    Backend --> Frontend : 400 Bad Request
    Frontend --> User : Show validation error
else Not participant
    Backend --> Frontend : 403 Forbidden
    Frontend --> User : Access denied
else Valid handover
    Backend -> Storage : Save handover photo
    Storage --> Backend : imageUrl
    Backend -> DB : Save Transaction (ACTIVE), Evidence (HANDOVER), Item -> BORROWED
    DB --> Backend : Committed
    Backend --> Frontend : 200 OK
    Frontend --> User : Status updated to Borrowed
end
@enduml

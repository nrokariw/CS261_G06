@startuml
title US-02: Browse Available Items
skinparam style strictuml
autonumber

actor User
participant Frontend
participant Backend
database DB

User -> Frontend : Open Browse page
Frontend -> Backend : GET /api/items?status=AVAILABLE

alt Unauthorized
    Backend --> Frontend : 401 Unauthorized
    Frontend --> User : Redirect to login
else Authenticated
    Backend -> DB : Fetch AVAILABLE items
    DB --> Backend : Item list
    Backend --> Frontend : 200 OK
    alt Items found
        Frontend --> User : Render item cards
    else Empty list
        Frontend --> User : Show empty state
    end
end
@enduml

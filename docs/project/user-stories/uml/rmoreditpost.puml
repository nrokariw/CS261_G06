@startuml
title US-04: Update or Delete Item Listing
skinparam style strictuml
autonumber

actor Lender
participant Frontend
participant Backend
participant Storage
database DB

Lender -> Frontend : Update or delete listing
Frontend -> Backend : PUT or DELETE /api/items/{id}
Backend -> DB : Fetch Item
DB --> Backend : Item (ownerId, status)

alt Not owner
    Backend --> Frontend : 403 Forbidden
    Frontend --> Lender : Access denied
else Item not AVAILABLE
    Backend --> Frontend : 409 Conflict
    Frontend --> Lender : Cannot modify active loan
else Owner & AVAILABLE
    alt Update
        Backend -> DB : Update Item details
    else Delete
        Backend -> DB : Soft-delete Item (UNAVAILABLE)
        opt Remove image
            Backend -> Storage : Delete image file
        end
    end
    DB --> Backend : Saved
    Backend --> Frontend : 200 OK
    Frontend --> Lender : Refresh listings
end
@enduml
